# ==============================================================================
# Agent_AI Environment Variables
# Powered by LangGraph, LangChain, Pydantic & Groq
# ==============================================================================

# Your free Groq API Key (from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq LLM model to power all nodes in the LangGraph workflow
GROQ_MODEL=qwen/qwen3.8-27b

# Guardrail & Safety
GUARDRAILS_ENABLED=true

# Execution Settings
MAX_REPAIR_ATTEMPTS=3
EXECUTION_TIMEOUT=45.0
